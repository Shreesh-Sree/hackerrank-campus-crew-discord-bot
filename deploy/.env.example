# ==============================================================================
# HackerRank Campus Crew Super Agent (hrcc_bot) — Environment Configuration
# ==============================================================================

# Discord Bot Credentials
DISCORD_BOT_TOKEN="YOUR_DISCORD_BOT_TOKEN_HERE"
DISCORD_HOME_CHANNEL="1550794920539717638"
ALLOW_ALL_USERS=true

# vLLM Local Inference Engine (Hosted on ai-server port 8000)
VLLM_BASE_URL="http://127.0.0.1:8000/v1"
VLLM_MODEL="neuralmagic/Meta-Llama-3.1-8B-Instruct-FP8"
VLLM_API_KEY="Placements@sjgi#2026"
VLLM_TIMEOUT=30.0
VLLM_MAX_RETRIES=3

# Generation Hyperparameters
MODEL_TEMPERATURE=0.1
MODEL_MAX_TOKENS=1500
CONTEXT_HISTORY_LIMIT=8
RATE_LIMIT_PER_MINUTE=15

# Point of Contact (POC) Discord User IDs for DM Routing
POC_DISCORD_SANSKRUTI=""
POC_DISCORD_SREESANTH="1207248110879768620"
POC_DISCORD_NITISH=""

# HRW API (HackerRank for Work)
HRW_API_KEY=""

# Role-based access
OWNER_DISCORD_ID=""

# Escalation Router Settings
ENABLE_DM_ROUTING=true
ESCALATION_COOLDOWN_HOURS=2
ENABLE_P0_OVERRIDE=true

# Database (leave empty to use SQLite fallback at data/hrcc.db)
DATABASE_URL=""
# DATABASE_URL="postgresql://hrcc_user:CampusCrewPostgres2026!@localhost:5433/hrcc_bot"

# Production Operations
LOG_LEVEL="INFO"
HEALTH_CHECK_INTERVAL=60
KNOWLEDGE_RELOAD_INTERVAL=300
MAX_CONVERSATION_TURNS=8
DB_PATH="data/hrcc.db"
